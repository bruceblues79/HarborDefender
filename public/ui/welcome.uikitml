<!--
  Panel and Button come from the bundled Horizon kit.
  Column layout with explicit heights (flex-grow is not supported in UIKitML).
  Panel inner area: 100 - 4*2 padding = 92.
  Title: 70, Button: 22.
-->
<style>
  .panel-root {
    display: flex;
    flex-direction: column;
    width: 100;
    height: 100;
    background-color: #18181b;
    border-radius: 4;
    padding: 4;
  }

  .title-section {
    display: flex;
    height: 70;
    justify-content: center;
    align-items: center;
  }

  .title-text {
    font-size: 10;
    font-weight: 700;
    color: #2020fc;
    text-align: center;
  }

  .button-section {
    display: flex;
    height: 22;
    justify-content: center;
    align-items: center;
  }

  .enter-button {
    font-size: 6;
    padding: 6;
  }
</style>

<Panel class="panel-root">
  <div class="title-section">
    <div class="title-text">Harbor Defender</div>
  </div>
  <div class="button-section">
    <Button id="enter-game-button" class="enter-button">ENTER GAME</Button>
  </div>
</Panel>
