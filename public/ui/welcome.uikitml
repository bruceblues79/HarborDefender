<!--
  Panel and Button come from the bundled Horizon kit.
  Column layout: 5 equal sections (flex-grow 4:1).
  Top 4/5: "Harbor Defender" title.
  Bottom 1/5: "ENTER GAME" button (reserved interface).
-->
<style>
  .panel-root {
    display: flex;
    flex-direction: column;
    width: 100;
    height: 100;
    background-color: #18181b;
    border-radius: 4;
    padding: 4;
  }

  .title-section {
    display: flex;
    flex-grow: 4;
    justify-content: center;
    align-items: center;
  }

  .title-text {
    font-size: 10;
    font-weight: 700;
    color: #2020fc;
    text-align: center;
  }

  .button-section {
    display: flex;
    flex-grow: 1;
    justify-content: center;
    align-items: center;
  }
</style>

<Panel class="panel-root">
  <div class="title-section">
    <div class="title-text">Harbor Defender</div>
  </div>
  <div class="button-section">
    <Button id="enter-game-button">ENTER GAME</Button>
  </div>
</Panel>
