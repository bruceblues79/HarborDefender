<!--
  Pause menu, expanded downward from the call button: 150 × 100 UIKit units
  = 1.5 m × 1 m at scale 1. Three dark buttons in a column, each filling the
  full width inside the root padding (space-between distributes the rows).
  Panel surface: stock glass preset over a light background, same as the
  welcome / start panels; hex8 alpha 0.67. Breathing room:
  root padding 10 on all sides, buttons 112 × 22 centered (19-unit visual
  side margins) with 3 vertical padding — 3 × 22 + 2 gaps of 7 (space-between)
  fills the remaining 80-unit column.
-->
<style>
  .menu-root {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: center;
    width: 150;
    height: 100;
    border-radius: 6;
    padding-top: 10;
    padding-right: 10;
    padding-bottom: 10;
    padding-left: 10;
    panel-material-class: glass;
    background-color: #ffffffaa;
  }

  .menu-button {
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    width: 112;
    height: 22;
    background-color: #26262b;
    color: #ffffff;
    font-size: 7;
    font-weight: 700;
    text-align: center;
    border-radius: 3;
    padding-top: 3;
    padding-right: 0;
    padding-bottom: 3;
    padding-left: 0;
    cursor: pointer;
  }

  .menu-button:hover {
    background-color: #3a3a42;
  }

  .menu-button:active {
    background-color: #1c1c21;
  }
</style>

<Panel class="menu-root">
  <button id="menu-main-button" class="menu-button">MAIN</button>
  <button id="menu-restart-button" class="menu-button">RESTART</button>
  <button id="menu-resume-button" class="menu-button">RESUME</button>
</Panel>
