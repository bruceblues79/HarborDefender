<!--
  Loading overlay panel.
  100 × 50 UIKit units = 1 m × 0.5 m at scale 1.
  Faces +Z by default.
  Same unlit default Horizon panel as the welcome screen: no glass material
  class, so it renders identically before any environment map is available.
  Text is dark for contrast on the light fill.
-->
<style>
  .panel-root {
    display: flex;
    flex-direction: row;
    width: 100;
    height: 50;
    justify-content: center;
    align-items: center;
    background-color: #e8e8e8;
    border-radius: 4;
  }

  .loading-text {
    font-size: 6;
    font-weight: 700;
    color: #202030;
    text-align: center;
  }
</style>

<Panel class="panel-root">
  <div class="loading-text">LOADING...</div>
</Panel>
