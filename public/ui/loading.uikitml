<!--
  Loading overlay panel.
  100 × 50 UIKit units = 1 m × 0.5 m at scale 1.
  Faces +Z by default.
-->
<style>
  .panel-root {
    display: flex;
    flex-direction: row;
    width: 100;
    height: 50;
    justify-content: center;
    align-items: center;
    background-color: #1a1a2e;
    border-radius: 2;
  }

  .loading-text {
    font-size: 6;
    font-weight: 700;
    color: #ffffff;
    text-align: center;
  }
</style>

<Panel class="panel-root">
  <div class="loading-text">LOADING...</div>
</Panel>
